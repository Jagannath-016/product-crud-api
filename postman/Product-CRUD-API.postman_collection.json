{
  "info": {
    "_postman_id": "4f50a473-021a-49b5-a948-a2aaf623d867",
    "name": "Product CRUD API",
    "description": "Requests for creating, reading, updating, and deleting products. Run in order; Create Product stores productId for the later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API and database are ready', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().database).to.eql('connected');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Java Basics Book\",\n  \"description\": \"A beginner-friendly programming book.\",\n  \"price\": 19.99,\n  \"category\": \"Books\",\n  \"inStock\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product is created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const responseBody = pm.response.json();",
              "pm.collectionVariables.set('productId', responseBody.data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Read All Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product list is returned', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Read One Product",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('One product is returned', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Product",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 17.99,\n  \"description\": \"Updated description.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product is updated', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.price).to.eql(17.99);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product is deleted', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.collectionVariables.unset('productId');"
            ]
          }
        }
      ]
    }
  ]
}
